# === Fase 1 — esqueleto (sem segredos reais) ===
# Copie para .env e preencha localmente. NUNCA commite o .env.

# App
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco (Postgres LOCAL — decisao 3.1 / docs/15)
# Use um Postgres local de desenvolvimento. NAO usar dados reais / PII real.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sinarm_cac_dev

# Logs (pino)
LOG_LEVEL=debug

# === Autenticacao do PRODUTO (NAO e Gov.br) ===
# "mock" = perfis ficticios de desenvolvimento (padrao).
# "real" = login por e-mail/senha, com sessao opaca no banco.
AUTH_MODE=mock
#
# Segredo que assina o cookie de sessao. OBRIGATORIO quando AUTH_MODE=real —
# sem ele o modo real se recusa a iniciar. Minimo 32 caracteres.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# NUNCA commitar o valor. Trocar o segredo derruba todas as sessoes ativas.
AUTH_SESSION_SECRET=

# === Fase 5 — Pix SANDBOX/DEV (decisao 3.4 / docs/15, docs/17) ===
# NUNCA cobranca Pix real nesta fase. NUNCA credencial de producao aqui.
# "fake"        -> provider de desenvolvimento, sem credencial nenhuma.
# "mercadopago" -> SANDBOX do Mercado Pago; use APENAS o access token de TESTE
#                  (comeca com TEST-), obtido no painel de desenvolvedor.
PAYMENT_PROVIDER=fake
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# As chaves abaixo NAO fazem parte das fases atuais (decisoes PENDENTE docs/15).
# Serao adicionadas na fase que as introduzir:
#   Redis/fila, Storage de producao, Auth real (usuario/admin), e-mail, cifra/KMS.
# ---------------------------------------------------------------------------
