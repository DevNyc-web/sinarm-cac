{
  "name": "sinarm-cac",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma web/PWA de assistência a processos SINARM/CAC (Guia de Tráfego). Esqueleto — Fase 1.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:phase9": "playwright test -c playwright.phase9.config.ts",
    "test:e2e:phase9:headed": "playwright test -c playwright.phase9.config.ts --headed",
    "test:documents:unit": "tsx --test tests/unit/documents/documentTypes.test.ts tests/unit/documents/documentStatus.test.ts tests/unit/documents/documentRequirements.test.ts tests/unit/documents/documentExtraction.test.ts tests/unit/documents/documentExtractionPersistence.test.ts tests/unit/documents/documentExtractionEngine.test.ts tests/unit/documents/documentExtractionConcurrency.test.ts tests/unit/documents/documentExtractionWorker.test.ts tests/unit/documents/documentExtractionReaper.test.ts tests/unit/documents/extractionOpsAction.test.ts tests/unit/documents/enqueueExtractions.test.ts tests/unit/documents/documentExtractionRead.test.ts tests/unit/documents/documentIntake.test.ts tests/unit/documents/documentUploadContract.test.ts tests/unit/documents/documentAccess.test.ts tests/unit/documents/documentExtractionReview.test.ts tests/unit/documents/documentFieldSuggestions.test.ts tests/unit/documents/documentSuggestionApply.test.ts tests/unit/automation/automationReadiness.test.ts tests/unit/automation/automationQueue.test.ts tests/unit/automation/automationQueueSubmission.test.ts tests/unit/automation/readinessExtractionFields.test.ts tests/unit/automation/processReadinessRequirements.test.ts tests/unit/automation/labRedaction.test.ts tests/unit/automation/labRunReport.test.ts tests/unit/processes/processCatalog.test.ts tests/unit/processes/internalStatusStates.test.ts tests/unit/processes/operationalSignals.test.ts tests/unit/processes/adminRealCancellationView.test.ts tests/unit/processes/needsFinanceReview.test.ts tests/unit/processes/clientCancellationNotice.test.ts tests/unit/processes/adminFinancialReport.test.ts tests/unit/processes/operationalStatusWrites.test.ts tests/unit/processes/statusDivergence.test.ts tests/unit/processes/operationalStatusProjection.test.ts tests/unit/processes/operationalProjectionEquivalence.test.ts tests/unit/processes/documentInternalStatuses.test.ts tests/unit/processes/clientVisibleStatus.test.ts tests/unit/processes/processEvents.test.ts tests/unit/processes/pricing.test.ts tests/unit/processes/processAvailability.test.ts tests/unit/processes/processDocumentRequirements.test.ts tests/unit/processes/processTypeMapping.test.ts tests/unit/processes/processTypeSeed.test.ts tests/unit/processes/concessaoCrPreparation.test.ts tests/unit/processes/cadastroInicialPreparation.test.ts tests/unit/processes/autorizacaoCompraPreparation.test.ts tests/unit/processes/emissaoCrafPreparation.test.ts tests/unit/services/getAdminProcessDetail.test.ts tests/unit/services/getAdminQueue.test.ts tests/unit/services/applyDestinationSuggestion.test.ts tests/unit/services/uploadProcessDocument.test.ts tests/unit/services/reviewProcessDocument.test.ts tests/unit/services/reopenDocumentReview.test.ts tests/unit/services/approveDocumentOutOfFlow.test.ts tests/unit/services/cancelProcess.test.ts tests/unit/services/updateProcessOperations.test.ts tests/unit/services/createPixPayment.test.ts tests/unit/services/confirmPixPayment.test.ts tests/unit/services/transitionInternalStatus.test.ts tests/unit/components/extractionSourceCopy.test.ts tests/unit/components/processRequirementsSummary.test.ts tests/unit/components/concessaoCrPreparationPreview.test.ts tests/unit/components/cadastroInicialPreparationPreview.test.ts tests/unit/components/autorizacaoCompraPreparationPreview.test.ts tests/unit/components/emissaoCrafPreparationPreview.test.ts",
    "test:phase9:unit": "tsx --test tests/unit/phase9/safety.test.ts tests/unit/phase9/networkGuard.test.ts tests/unit/phase9/auditLogger.test.ts tests/unit/phase9/phase9Runner.test.ts",
    "test:auth:unit": "tsx --test tests/unit/auth/authFoundation.test.ts tests/unit/auth/password.test.ts tests/unit/auth/sessionToken.test.ts tests/unit/auth/rateLimit.test.ts tests/unit/auth/authenticate.test.ts tests/unit/auth/signupForm.test.ts",
    "test:support:unit": "tsx --test tests/unit/support/helpContent.test.ts tests/unit/support/supportChannel.test.ts tests/unit/support/clientOnboarding.test.ts tests/unit/support/documentChecklistNotices.test.ts tests/unit/components/helpSections.test.ts tests/unit/components/clientStartPanel.test.ts tests/unit/components/documentChecklistView.test.ts",
    "test:unit:all": "npm run test:documents:unit && npm run test:phase9:unit && npm run test:auth:unit && npm run test:support:unit",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "next": "^15.1.0",
    "pino": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prisma": "^6.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
