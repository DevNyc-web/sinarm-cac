// Schema Prisma — evoluido desde a Fase 1 (docs/16 §11).
// A partir da fundacao de auth, o schema passou a ser versionado por MIGRATIONS
// (prisma/migrations/). `db push` deixa de ser o caminho: producao exige historico.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Perfis de acesso. Espelha `src/server/auth/roles.ts` — a paridade entre os dois
/// e travada por teste (`tests/unit/auth/authFoundation.test.ts`). O banco recusar
/// papel invalido e a razao de ser um enum, e nao `String`.
enum Role {
  USER
  ADMIN
  OPERADOR
  FINANCEIRO
  SUPORTE

  @@map("role")
}

/// Usuario do produto — cliente final e equipe interna na MESMA tabela, separados
/// por `role` (docs/11 §2).
///
/// FUNDACAO de auth, nao auth real: NAO ha campo de senha, sessao nem MFA neste
/// modelo. Login real, `passwordHash` e sessao assinada entram no PR seguinte —
/// campo de credencial sem fluxo de login seria superficie de risco sem uso.
///
/// NADA aqui guarda credencial de Gov.br/SINARM. A senha que existira no futuro e
/// do PRODUTO; credencial de orgao oficial continua proibida (docs/00 §8).
model User {
  id           String   @id @default(uuid())
  /// SEMPRE gravado normalizado (trim + minusculo) — o indice unico e
  /// case-sensitive, entao normalizar so na leitura criaria conta inacessivel e
  /// permitiria duplicata disfarcada. Ver `normalizeEmail` em `authenticate.ts`.
  email        String   @unique
  name         String
  /// Senha do PRODUTO, formato versionado `scrypt$N$r$p$salt$hash`.
  ///
  /// NULLABLE de proposito: os usuarios de seed nao tem senha, e `null` significa
  /// "nao entra por senha". NUNCA sai em DTO — `AuthUser` nao tem este campo.
  ///
  /// NAO E, e nunca sera, senha de Gov.br/SINARM: guardar credencial de orgao
  /// oficial continua proibido (docs/00 §8).
  passwordHash String?  @map("password_hash")
  role         Role     @default(USER)
  /// Desativa o acesso sem apagar o historico (processos sao trilha operacional).
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  processes Process[]
  sessions  Session[]

  @@index([role])
  @@map("users")
}

/// Sessao OPACA do produto. O cookie carrega `<token>.<hmac>`; aqui fica apenas o
/// SHA-256 do token — vazamento desta tabela NAO concede sessao.
///
/// `onDelete: Cascade` (ao contrario de `Process`, que e `Restrict`): sessao nao e
/// trilha de auditoria, e sessao orfa nao tem sentido.
model Session {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 hex do token. O token em claro nunca e persistido.
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime @default(now()) @map("last_used_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Catalogo de tipos de processo. MVP: apenas Guia de Trafego. Ver docs/12 §3.4.
model ProcessType {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  baseFeeCents Int       @map("base_fee_cents")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  processes    Process[]

  @@map("process_types")
}

/// Processo SEM PII (Fases 1–3). Campos sensiveis (documento, pagamento, GRU,
/// endereco SIGMA) chegam em fases posteriores. Ver docs/12 §3.3.
/// `userId` e o id do usuario MOCK (Fase 2) — vira FK para `users` quando a
/// auth real entrar (docs/15 §3.8).
model Process {
  id                    String                 @id @default(uuid())
  code                  String                 @unique
  userId                String                 @map("user_id")
  /// `onDelete: Restrict` de proposito: apagar usuario NAO pode arrastar processo.
  /// Processo e registro operacional (e potencialmente fiscal) — desativa-se o
  /// usuario via `User.active`, nao se apaga a trilha.
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  processTypeId         String                 @map("process_type_id")
  processType           ProcessType            @relation(fields: [processTypeId], references: [id])
  internalStatus        InternalStatus         @default(RASCUNHO) @map("internal_status")
  userFacingStatus      UserFacingStatus       @default(RECEBIDO) @map("user_facing_status")
  /// Trilha OPERACIONAL do modo dev/assistido (Fase 6). Nao substitui
  /// `internalStatus` (docs/12 §6, canonico, com estados SINARM/GRU): e a visao
  /// que a fila/operacao usa enquanto nao ha protocolo real. As transicoes
  /// sincronizam `userFacingStatus` para o usuario nao ver algo divergente.
  operationalStatus     OperationalStatus      @default(RASCUNHO) @map("operational_status")
  priority              ProcessPriority        @default(NORMAL)
  /// Responsavel atual (usuario MOCK — docs/11 §4). Vira FK com auth real.
  assignedToMockUserId  String?                @map("assigned_to_mock_user_id")
  notes                 ProcessNote[]
  /// Etapa da EXECUCAO ASSISTIDA MANUAL (Fase 7, docs/21). Descreve o que o
  /// OPERADOR HUMANO declarou ter feito FORA do app. O sistema nao acessa
  /// Gov.br/SINARM, nao automatiza e nao protocola.
  manualExecutionStatus ManualExecutionStatus  @default(EXECUCAO_MANUAL_NAO_INICIADA) @map("manual_execution_status")
  manualExecution       ManualExecution?
  /// Padrao "Guia para treino", editavel (docs/10 §4).
  justification         String                 @map("justification")
  destination           Destination?
  firearm               FirearmPce?
  statusEvents          ProcessStatusEvent[]
  checklistItems        ProcessChecklistItem[]
  documents             ProcessDocument[]
  payments              Payment[]
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([userId])
  @@index([operationalStatus])
  @@index([assignedToMockUserId])
  @@map("processes")
}

/// Status operacional da fila em modo dev/assistido (Fase 6).
/// NAO inclui estados de protocolo/GRU real — o MVP e assistido e nada e
/// protocolado nesta fase (docs/10 §17, docs/11 §20).
enum OperationalStatus {
  RASCUNHO
  DOCUMENTO_ENVIADO
  DOCUMENTO_APROVADO
  AGUARDANDO_PAGAMENTO
  PAGO_EM_FILA
  EM_REVISAO_OPERACIONAL
  /// Pronto para o operador protocolar MANUALMENTE no SINARM (fora do app).
  PRONTO_PARA_PROTOCOLO_MANUAL
  BLOQUEADO
  /// Cancelamento em ambiente de desenvolvimento (nao e reembolso real).
  CANCELADO_DEV

  @@map("operational_status")
}

/// Etapas da execucao assistida MANUAL (docs/21 §8).
/// Cada estado descreve uma DECLARACAO do operador humano sobre algo feito
/// fora do app. Nenhum estado faz o sistema agir no orgao.
enum ManualExecutionStatus {
  EXECUCAO_MANUAL_NAO_INICIADA
  GOVBR_ABERTO_PELO_OPERADOR
  SINARM_ABERTO_PELO_OPERADOR
  FORMULARIO_PREENCHIDO_MANUALMENTE
  CHECKPOINT_DADOS_GRU_CONFERIDO
  PROTOCOLO_MANUAL_REGISTRADO
  GRU_MANUAL_REGISTRADA
  AGUARDANDO_PAGAMENTO_GRU_EMPRESA
  GRU_PAGA_MANUALMENTE_DEV
  BLOQUEADO_OPERACIONALMENTE

  @@map("manual_execution_status")
}

/// Registro do que o HUMANO fez fora do app (docs/21 §6) — protocolo, dados da
/// GRU e pagamento da GRU pela empresa. Em modo dev/ficticio: NUNCA protocolo
/// real, NUNCA GRU real de producao. O app nao gerou nada disso.
model ManualExecution {
  id        String  @id @default(uuid())
  processId String  @unique @map("process_id")
  process   Process @relation(fields: [processId], references: [id])

  /// --- Protocolo registrado manualmente (ficticio/dev) ---
  protocolNumber                 String?   @map("protocol_number")
  protocolObservation            String?   @map("protocol_observation")
  protocolRegisteredByMockUserId String?   @map("protocol_registered_by_mock_user_id")
  protocolRegisteredByRole       String?   @map("protocol_registered_by_role")
  protocolRegisteredAt           DateTime? @map("protocol_registered_at")

  /// --- Dados da GRU registrados manualmente (ficticios/dev) ---
  gruReference              String?   @map("gru_reference")
  /// Vencimento LIDO do sistema pelo operador — nunca fixado pelo app (docs/10 §4).
  gruDueDate                DateTime? @map("gru_due_date")
  gruAmountCents            Int?      @map("gru_amount_cents")
  gruObservation            String?   @map("gru_observation")
  gruRegisteredByMockUserId String?   @map("gru_registered_by_mock_user_id")
  gruRegisteredByRole       String?   @map("gru_registered_by_role")
  gruRegisteredAt           DateTime? @map("gru_registered_at")

  /// --- Pagamento da GRU pela empresa (docs/11 §9), registrado pelo Financeiro ---
  gruPaidAt                        DateTime? @map("gru_paid_at")
  gruPaymentObservation            String?   @map("gru_payment_observation")
  gruPaymentRegisteredByMockUserId String?   @map("gru_payment_registered_by_mock_user_id")
  gruPaymentRegisteredByRole       String?   @map("gru_payment_registered_by_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("manual_executions")
}

/// Prioridade operacional da fila (docs/11 §4).
enum ProcessPriority {
  BAIXA
  NORMAL
  ALTA
  URGENTE

  @@map("process_priority")
}

/// Notas internas e mensagens ao usuario (docs/11 §5.11/§17).
/// Texto livre — a UI avisa para NAO escrever PII (docs/11 §19).
model ProcessNote {
  id               String         @id @default(uuid())
  processId        String         @map("process_id")
  process          Process        @relation(fields: [processId], references: [id])
  visibility       NoteVisibility @default(INTERNA)
  body             String
  authorMockUserId String         @map("author_mock_user_id")
  authorRole       String         @map("author_role")
  createdAt        DateTime       @default(now()) @map("created_at")

  @@index([processId])
  @@map("process_notes")
}

/// Visibilidade da nota: interna (equipe) ou mensagem ao usuario (docs/11 §11).
enum NoteVisibility {
  INTERNA
  VISIVEL_USUARIO

  @@map("note_visibility")
}

/// Historico imutavel de mudancas de status (docs/12 §3.5). APPEND-ONLY:
/// nunca editar/apagar. `actorMockUserId`/`actorRole` referem-se aos usuarios
/// MOCK da Fase 2 — viram FK/enum reais quando a auth real entrar.
model ProcessStatusEvent {
  id              String           @id @default(uuid())
  processId       String           @map("process_id")
  process         Process          @relation(fields: [processId], references: [id])
  /// Tipo do evento — a trilha cobre status, prioridade, responsavel e notas.
  kind            ProcessEventKind @default(STATUS_INTERNO)
  fromStatus      InternalStatus?  @map("from_status")
  /// Nulo em eventos que nao mudam o status interno (prioridade, responsavel…).
  toStatus        InternalStatus?  @map("to_status")
  /// Valores genericos dos eventos operacionais (rotulos curtos, SEM PII).
  fromValue       String?          @map("from_value")
  toValue         String?          @map("to_value")
  actorMockUserId String           @map("actor_mock_user_id")
  actorRole       String           @map("actor_role")
  /// Texto curto, SEM PII (docs/12 §3.5).
  note            String?
  createdAt       DateTime         @default(now()) @map("created_at")

  @@index([processId])
  @@map("process_status_events")
}

/// Tipos de evento da trilha do processo (docs/11 §18).
enum ProcessEventKind {
  STATUS_INTERNO
  STATUS_OPERACIONAL
  PRIORIDADE
  RESPONSAVEL
  NOTA
  /// Fase 7 — registros da execucao assistida MANUAL (docs/21 §9).
  EXECUCAO_MANUAL
  PROTOCOLO_MANUAL
  GRU_MANUAL
  PAGAMENTO_GRU_MANUAL

  @@map("process_event_kind")
}

/// Itens do checklist de revisao admin (docs/11 §6, versao dev/mock).
/// Registra quem marcou (usuario mock + perfil) e quando — base da futura
/// auditoria (docs/11 §18). Um item por (processo, key).
model ProcessChecklistItem {
  id                  String         @id @default(uuid())
  processId           String         @map("process_id")
  process             Process        @relation(fields: [processId], references: [id])
  /// Grupo do item: revisao geral (docs/11 §6) ou checkpoint GRU (docs/11 §7).
  group               ChecklistGroup @default(REVISAO)
  key                 String
  label               String
  checked             Boolean        @default(false)
  checkedByMockUserId String?        @map("checked_by_mock_user_id")
  checkedByRole       String?        @map("checked_by_role")
  checkedAt           DateTime?      @map("checked_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  @@unique([processId, key])
  @@map("process_checklist_items")
}

/// Grupos de checklist: revisao geral (docs/11 §6) e checkpoint "Dados da GRU"
/// (docs/11 §7). O checkpoint GRU aqui e FICTICIO: nao acessa SINARM, nao gera
/// GRU e nao protocola — so registra a conferencia humana.
enum ChecklistGroup {
  REVISAO
  GRU
  /// Fase 7 — conferencia POS-PROTOCOLO do que o humano registrou (docs/21 §12).
  POS_PROTOCOLO

  @@map("checklist_group")
}

/// Destino/clube/evento informado pelo usuario (docs/12 §3.7). Dados de local
/// de evento — ficticios nesta fase; nao ha PII de pessoa.
model Destination {
  id        String   @id @default(uuid())
  processId String   @unique @map("process_id")
  process   Process  @relation(fields: [processId], references: [id])
  eventName String   @map("event_name")
  uf        String
  city      String
  street    String
  number    String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("destinations")
}

/// Arma/PCE indicada — SUBCONJUNTO NAO SENSIVEL do docs/12 §3.8.
/// Campos cifrados (sigma_number, serial_number, lot_number) ficam FORA ate a
/// decisao de criptografia 3.10 (docs/15). Nesta fase, os valores vem de um
/// catalogo MOCK 100% ficticio (src/server/processes/mockFirearms.ts).
model FirearmPce {
  id            String   @id @default(uuid())
  processId     String   @unique @map("process_id")
  process       Process  @relation(fields: [processId], references: [id])
  /// Id do item no catalogo mock — para rastrear a escolha em dev.
  mockCatalogId String   @map("mock_catalog_id")
  species       String
  brand         String
  model         String
  caliber       String
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("firearms_pce")
}

/// Documento anexado ao processo (docs/12 §3.6) — Fase 4 em modo DEV/FICTICIO.
/// Os BYTES ficam no storage local/dev (adapter), NUNCA no banco. Apenas
/// metadados + sha256 aqui. SEM documento real, SEM PII real (docs/15 §3.2/§3.10).
model ProcessDocument {
  id                   String         @id @default(uuid())
  processId            String         @map("process_id")
  process              Process        @relation(fields: [processId], references: [id])
  type                 DocumentType   @default(IDENTIFICACAO_PESSOAL)
  status               DocumentStatus @default(ENVIADO)
  originalFileName     String         @map("original_file_name")
  mimeType             String         @map("mime_type")
  sizeBytes            Int            @map("size_bytes")
  sha256               String
  storageKey           String         @map("storage_key")
  uploadedByMockUserId String         @map("uploaded_by_mock_user_id")
  reviewedByMockUserId String?        @map("reviewed_by_mock_user_id")
  reviewedByRole       String?        @map("reviewed_by_role")
  reviewedAt           DateTime?      @map("reviewed_at")
  /// Motivo curto, SEM reproduzir PII do documento (docs/11 §14).
  rejectionReason      String?        @map("rejection_reason")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  extractions DocumentExtraction[]

  @@index([processId])
  @@map("process_documents")
}

/// Estado de UMA tentativa de extracao (docs/25). Espelha `EXTRACTION_STATES` em
/// `src/server/documents/documentExtractionTypes.ts` — a paridade e travada por
/// teste, pelo mesmo motivo de `Role`: o banco recusar estado invalido.
enum ExtractionState {
  PENDENTE
  PROCESSANDO
  EXTRAIDA
  PRECISA_REVISAO
  CONFIRMADA
  FALHOU

  @@map("extraction_state")
}

/// Tentativa de extracao de um documento.
///
/// 1:N de proposito (uma linha POR TENTATIVA, historico preservado): decisao
/// automatica precisa saber em qual extracao se baseou, reprocessamento nao pode
/// apagar a evidencia anterior, e trocar `engineVersion` exige comparar motores.
///
/// NAO ha OCR nesta fase: a tabela existe para receber o resultado quando o motor
/// entrar. Nada aqui toca Gov.br/SINARM/PF, storage ou rede.
///
/// ATENCAO — ESTA TABELA TEM UM INDICE QUE O SCHEMA NAO DECLARA:
/// `document_extractions_one_active_per_document` e um UNIQUE PARCIAL
/// (`WHERE state IN ('PENDENTE','PROCESSANDO')`) criado em SQL cru na migration
/// `20260729000000_extraction_single_active`. O Prisma nao expressa `WHERE` em
/// @@index/@@unique, entao ele vive so la.
///
/// Consequencia: use `npm run db:migrate` / `db:deploy`. `npm run db:push`
/// sincroniza o banco COM ESTE SCHEMA e pode remover aquele indice em silencio —
/// e sem ele o banco volta a aceitar duas tentativas ativas no mesmo documento.
model DocumentExtraction {
  id         String          @id @default(uuid())
  documentId String          @map("document_id")
  document   ProcessDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  state ExtractionState @default(PENDENTE)

  /// PII — campos extraidos + confianca POR CAMPO. So pode ser lido por quem tem
  /// `process.pii.viewFull`; o repositorio nao o inclui no select base.
  fields Json?

  /// Agregado derivado do PIOR campo (ALTA/MEDIA/BAIXA). Atalho de consulta —
  /// a fonte de verdade continua sendo a confianca por campo dentro de `fields`.
  confidence String?

  engine        String
  engineVersion String @map("engine_version")

  /// Codigo curto e sanitizado (ver `EXTRACTION_FAILURE_REASONS` no dominio).
  /// NUNCA texto bruto de OCR nem qualquer credencial — a regra permanente de
  /// docs/00 §8 vale aqui como no resto do schema.
  failureReason String? @map("failure_reason")

  extractedAt    DateTime? @map("extracted_at")
  reviewedAt     DateTime? @map("reviewed_at")
  reviewedBy     String?   @map("reviewed_by_mock_user_id")
  reviewedByRole String?   @map("reviewed_by_role")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Ordem declarada: "a mais recente deste documento" e sempre
  /// (created_at DESC, id DESC) — sem isso, empate de milissegundo desempatava
  /// pelo que o Postgres devolvesse, e podia alternar entre execucoes.
  @@index([documentId, createdAt(sort: Desc), id(sort: Desc)])
  /// Varredura do reaper global (#47D-2): PROCESSANDO parada ha tempo demais.
  /// O relogio e `updated_at`, renovado no claim PENDENTE -> PROCESSANDO.
  @@index([state, updatedAt])
  /// Fila de trabalho (#47D-1): PENDENTE mais antigas primeiro. O indice acima,
  /// que comeca em `document_id`, NAO serve — a fila nao filtra por documento.
  @@index([state, createdAt, id])
  @@map("document_extractions")
}

/// Pagamento Pix do cliente (docs/12 §3.9) — Fase 5 em modo SANDBOX/DEV.
/// NUNCA cobranca real nesta fase (docs/15 §3.4): provider "fake" (dev) ou
/// Mercado Pago SANDBOX. `webhookEventId` unico garante idempotencia do webhook.
model Payment {
  id                String        @id @default(uuid())
  processId         String        @map("process_id")
  process           Process       @relation(fields: [processId], references: [id])
  provider          String // "fake" | "mercadopago" (adapter — docs/15 §3.4)
  providerPaymentId String?       @map("provider_payment_id")
  status            PaymentStatus @default(PENDENTE)
  amountCents       Int           @map("amount_cents")
  currency          String        @default("BRL")
  /// Payload do QR (sandbox/dev: texto claramente ficticio, nunca EMV real).
  pixQrCode         String?       @map("pix_qr_code")
  pixCopyPaste      String?       @map("pix_copy_paste")
  expiresAt         DateTime?     @map("expires_at")
  paidAt            DateTime?     @map("paid_at")
  /// Id do evento de webhook que confirmou o pagamento (idempotencia §7 #10).
  webhookEventId    String?       @unique @map("webhook_event_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@index([processId])
  @@index([providerPaymentId])
  @@map("payments")
}

/// Estados do pagamento Pix (docs/12 §8, nomes conforme decisao da F5).
enum PaymentStatus {
  PENDENTE
  AGUARDANDO_PAGAMENTO
  PAGO
  EXPIRADO
  CANCELADO
  FALHOU

  @@map("payment_status")
}

/// Tipos de documento (docs/12 §3.6).
/// Espelha os tipos de DOMINIO (src/server/documents/documentTypes.ts) para que
/// cada documento esperado da Guia de Trafego persista com o proprio tipo.
/// Adicao PURAMENTE ADITIVA: nenhum documento existente muda de valor.
/// `COMPLEMENTAR` (dominio) persiste como OUTRO — nao ha valor duplicado aqui.
enum DocumentType {
  IDENTIFICACAO_PESSOAL
  CR_REGISTRO_CAC
  COMPROVANTE_ORIGEM_ENDERECO
  DECLARACAO_DESTINO_EVENTO
  OUTRO

  @@map("document_type")
}

/// Estados do documento (docs/12 §10, nomes conforme decisao da F4).
enum DocumentStatus {
  PENDENTE
  ENVIADO
  EM_ANALISE
  APROVADO
  REJEITADO

  @@map("document_status")
}

/// Status internos (operacao). Ver docs/12 §6.
enum InternalStatus {
  RASCUNHO
  AGUARDANDO_PAGAMENTO
  PAGO_EM_FILA
  AGUARDANDO_LOGIN_GOVBR
  SESSAO_GOVBR_EXPIRADA
  EM_PREENCHIMENTO_SINARM
  EM_REVISAO_HUMANA
  BLOQUEADO_INSTABILIDADE
  EXCECAO_DOC_INVALIDO
  EXCECAO_ARMA_DIVERGENTE
  EXCECAO_DESTINO_INCOMPLETO
  PROTOCOLADO_GRU_GERADA
  GRU_PAGA_EMPRESA
  CONCLUIDO
  CANCELADO_REEMBOLSADO

  /// Pausas assistidas (docs/44 §6) — Fase 2. SEM CONSUMIDOR neste PR: nenhum
  /// fluxo escreve estes valores ainda; eles existem para que os fluxos da
  /// Fase 3 nasçam com o ponto de parada ja nomeado.
  ///
  /// NO FIM DO ENUM de proposito: `ALTER TYPE ... ADD VALUE` sem `BEFORE`/`AFTER`
  /// anexa ao fim no Postgres. Inserir no meio aqui faria a ordem do schema
  /// divergir da ordem real do tipo no banco — e a ordem do enum e o que o
  /// Postgres usa em `ORDER BY` sobre a coluna.
  ///
  /// Pausa antes do ato irreversivel (selecao de arma/PCE, "Gerar GRU e
  /// Salvar"). So sai por acao humana explicita: nenhum timeout, reaper ou
  /// retry atravessa este estado (docs/44 §7, invariante 2).
  AGUARDANDO_CONFIRMACAO_HUMANA
  /// Validacao humana exigida pelo portal. NAO existe e NAO existira caminho
  /// automatico para resolve-la: o sistema para e devolve para a pessoa
  /// (docs/00 §8, permanente). Diferente de `BLOQUEADO_INSTABILIDADE`, que o
  /// sistema pode retomar sozinho quando o portal voltar.
  AGUARDANDO_CAPTCHA

  /// Candidatos aprovados pela Fase 5d (docs/47) para os 2 dos 6 estados
  /// operacionais humanos (docs/46 §7) com jornada legitima. SEM CONSUMIDOR
  /// neste PR: nenhum fluxo escreve estes valores ainda — a migracao de
  /// `uploadProcessDocument` (5e) e do lado aprovacao de `reviewProcessDocument`
  /// (5f) ficam para PR proprio, mesmo padrao da Fase 2 acima.
  ///
  /// NO FIM DO ENUM pelo mesmo motivo da Fase 2: `ALTER TYPE ... ADD VALUE` sem
  /// `BEFORE`/`AFTER` anexa ao fim no Postgres.
  ///
  /// Equivalente a `OperationalStatus.DOCUMENTO_ENVIADO` (docs/47 §6.1):
  /// documento recebido do cliente, aguardando conferencia da equipe.
  DOCUMENTO_RECEBIDO_PARA_ANALISE
  /// Equivalente a `OperationalStatus.DOCUMENTO_APROVADO` (docs/47 §6.2):
  /// documento conferido e validado pela equipe. Nome distinto do
  /// `OperationalStatus` de origem de proposito — evita confundir os dois
  /// enums na leitura de codigo (docs/47 §6.2).
  DOCUMENTO_VALIDADO

  /// Decidido pelo docs/48 (2026-08-01) para `OperationalStatus.BLOQUEADO`.
  /// SEM CONSUMIDOR neste PR: nenhum fluxo escreve este valor ainda — o lado
  /// rejeicao de `reviewProcessDocument` (5f) e o `BLOQUEADO` da porta
  /// manual/admin (5g) ficam para PR proprio, mesmo padrao da Fase 2 e da 5d
  /// acima.
  ///
  /// NO FIM DO ENUM pelo mesmo motivo das duas adicoes anteriores:
  /// `ALTER TYPE ... ADD VALUE` sem `BEFORE`/`AFTER` anexa ao fim no Postgres.
  ///
  /// Bloqueio decidido por um HUMANO (rejeicao de documento ou dropdown do
  /// admin), sem causa apurada pelo sistema. Categoria NOVA de proposito:
  /// reutilizar `BLOQUEADO_INSTABILIDADE` ou qualquer `EXCECAO_*` — que sao
  /// pausas decididas pela AUTOMACAO, com causa ja tipada — afirmaria uma causa
  /// que ninguem verificou (docs/48 §4, docs/46 §3.4).
  ///
  /// NAO confundir com `ManualExecutionStatus.BLOQUEADO_OPERACIONALMENTE`:
  /// aquele descreve a execucao manual da equipe fora do app (Fase 7), este e o
  /// estado canonico do processo.
  BLOQUEADO_OPERACIONAL

  /// Decidido pelo docs/51 (2026-08-02) para o fluxo de cancelamento REAL de
  /// cliente. SEM FLUXO neste PR: nenhuma action, permissao ou porta escreve
  /// este valor ainda — a action explicita `cancelProcess` fica para PR
  /// proprio (docs/51 §5/§7). So prepara o enum de forma aditiva e segura.
  ///
  /// NO FIM DO ENUM pelo mesmo motivo das adicoes anteriores: `ALTER TYPE ...
  /// ADD VALUE` sem `BEFORE`/`AFTER` anexa ao fim no Postgres.
  ///
  /// NAO CONFUNDIR com `OperationalStatus.CANCELADO_DEV`: aquele e estado
  /// TECNICO/de desenvolvimento (marca processo de teste como morto, sem
  /// afirmar nada sobre reembolso ou decisao de cliente) e continua existindo
  /// sem mudanca — docs/51 decidiu explicitamente que `CANCELADO_DEV` NUNCA
  /// vira cancelamento real por reuso. Tambem NAO reutiliza
  /// `CANCELADO_REEMBOLSADO`, que AFIRMA reembolso (docs/46 §6, docs/49 §3.5).
  /// Categoria NOVA de proposito, mesmo criterio que `docs/48` usou para
  /// `BLOQUEADO_OPERACIONAL` acima.
  CANCELADO_OPERACIONAL

  @@map("internal_status")
}

/// Status visiveis ao usuario. Ver docs/12 §7.
enum UserFacingStatus {
  RECEBIDO
  PAGAMENTO_CONFIRMADO
  AGUARDANDO_SEU_LOGIN_GOVBR
  EM_ANDAMENTO
  AGUARDANDO_SISTEMA_PF
  PRECISAMOS_DE_UM_AJUSTE
  PROTOCOLADO
  CONCLUIDO
  CANCELADO

  @@map("user_facing_status")
}

/// Estados do RUN sintético — espelha `SyntheticRunState`
/// (`syntheticRunCoordinator.ts`). Paridade travada por teste, mesmo critério de
/// `Role`/`ExtractionState` acima. NÃO é o estado da sessão (ver
/// `synthetic_handoff_state` abaixo) — são camadas separadas por desenho
/// (docs da Fase 2 do motor sintético).
enum SyntheticRunDbState {
  QUEUED
  RUNNING
  WAITING_HUMAN
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED

  @@map("synthetic_run_state")
}

/// Os 8 estados do HANDOFF da sessão sintética — espelha `SyntheticHandoffState`
/// (`sessionContract.ts`). Só o ESTADO é persistido aqui; a sessão viva (com
/// `sessionHandle`) nunca é gravada — quem retoma um run fornece a sessão de
/// novo, na hora (ver `syntheticStoredRunExecutor.ts`).
enum SyntheticSessionDbState {
  CREATED
  CLAIMED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
  BLOCKED
  FAILED

  @@map("synthetic_handoff_state")
}

/// Registro PERSISTENTE do motor sintético — a mesma projeção segura de
/// `StoredSyntheticRun` (`syntheticRunStore.ts`), sem alteração de contrato.
///
/// NUNCA guarda `sessionHandle`, credencial, CPF ou qualquer dado do contrato de
/// sessão além do ESTADO (`sessionState`) e da correlação (`auditCorrelationId`) —
/// a regra permanente de docs/00 §8 vale aqui como no resto do schema.
///
/// `plan`/`pendingSteps`/`completedSteps`/`events`/`evidence`/`result` são JSON
/// SÓ porque já são estruturas FECHADAS e validadas pelo domínio antes de
/// gravar (`validateStoredSyntheticRun`) e IMEDIATAMENTE revalidadas depois de
/// ler — nunca um objeto arbitrário de fora.
///
/// Este é o MOTOR SINTÉTICO (laboratório local, loopback, fictício) — não tem
/// nenhuma relação com `Process`/`ProcessDocument` nem com a Fase 9.
model SyntheticRun {
  id String @id @default(uuid())

  /// Identificador de domínio do run — ver `SyntheticAutomationRun.runId`.
  runId String @unique @map("run_id")

  /// Chave fictícia de idempotência da CRIAÇÃO. Única: duas criações com a
  /// mesma chave e payload compatível devolvem o MESMO registro (ver
  /// `payloadFingerprint`); payload incompatível é conflito.
  idempotencyKey String @unique @map("idempotency_key")

  /// Fingerprint ESTÁVEL do payload de criação (runId + plano + correlação da
  /// sessão) — resolve "mesma chave, payload incompatível" sem duplicar o
  /// plano inteiro como segunda cópia só para comparação.
  payloadFingerprint String @map("payload_fingerprint")

  /// Concorrência otimista: começa em 1, cada `save` bem-sucedido incrementa
  /// em 1. Divergência de `expectedVersion` é conflito tipado, nunca
  /// sobrescrita silenciosa.
  version Int @default(1)

  runState     SyntheticRunDbState     @map("run_state")
  sessionState SyntheticSessionDbState @map("session_state")

  /// Substitui o `sessionHandle` como identificador de correlação seguro.
  auditCorrelationId String @map("audit_correlation_id")

  plan           Json @map("plan")
  pendingSteps   Json @map("pending_steps")
  completedSteps Json @map("completed_steps")
  events         Json @map("events")
  evidence       Json @map("evidence")

  humanFallbackRequired Boolean @default(false) @map("human_fallback_required")

  /// `{ outcome, syntheticProtocol, completedAt }` ou `null` enquanto o run
  /// não terminou. `syntheticProtocol` só é não-nulo em sucesso — falha nunca
  /// produz protocolo (regra do domínio, não deste schema).
  result Json? @map("result")

  attempts Int @default(0)

  /// Chave de idempotência do ÚLTIMO save de ETAPA bem-sucedido — permite
  /// reconhecer um replay ANTES de reservar o run, mesmo já terminal.
  lastStepIdempotencyKey String? @map("last_step_idempotency_key")

  /// Motivo tipado da última interrupção (`SyntheticFailureKind` ou
  /// `"CAPTCHA"`) — string curta e fechada, revalidada na leitura contra o
  /// vocabulário do domínio, nunca um enum de banco à parte (o domínio é a
  /// fonte de verdade da lista).
  lastInterruptionReason String? @map("last_interruption_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  claim SyntheticRunClaim?

  /// Varredura de `listRecoverable`: estado + o relógio da reserva (via
  /// relação) decidem elegibilidade; este índice cobre o filtro por estado.
  @@index([runState, updatedAt])
  @@map("synthetic_runs")
}

/// Reserva de trabalho sobre um `SyntheticRun` — tabela SEPARADA (não campo
/// embutido) de propósito: a garantia "só um claim ativo por run" e a limpeza
/// atômica na liberação/conclusão (DELETE, não UPDATE para null) ficam mais
/// simples e mais seguras como uma linha própria, 1:1 com o run.
///
/// Nunca guarda segredo: `workerId` é fictício, escolhido por quem chama.
model SyntheticRunClaim {
  id String @id @default(uuid())

  /// 1:1 com `SyntheticRun` — no máximo UMA linha de claim por run, e é o
  /// próprio Postgres que garante isso via este único.
  runId String       @unique @map("run_id")
  run   SyntheticRun @relation(fields: [runId], references: [runId], onDelete: Cascade)

  claimId  String @unique @map("claim_id")
  workerId String @map("worker_id")

  claimedAt DateTime @map("claimed_at")
  expiresAt DateTime @map("expires_at")

  /// Versão do run NO MOMENTO da reserva — só diagnóstico, não substitui o
  /// `expectedVersion` do `save`.
  runVersionAtClaim Int @map("run_version_at_claim")

  /// Varredura de reserva expirada (`listRecoverable`, e o próprio `claimNext`
  /// tentando substituir um claim vencido).
  @@index([expiresAt])
  @@map("synthetic_run_claims")
}

/// Estado persistido do PEDIDO ADMINISTRATIVO manual — espelha
/// `ManualDispatchRequestStatus` (`manualDispatchRequestRegistry.ts`). Não
/// confundir com `ManualSyntheticDispatchOutcome` (vocabulário do
/// RESULTADO, guardado dentro do JSON `result`, não como enum de coluna).
enum ManualDispatchRequestDbStatus {
  PENDING
  COMPLETED
  DENIED
  FAILED
  CANCELLED

  @@map("manual_dispatch_request_status")
}

/// Registro PERSISTENTE de idempotência do ACIONADOR ADMINISTRATIVO manual
/// (`admin/manualDispatchRequestRegistry.ts`) — garante que repetir o mesmo
/// `requestId` nunca chama `dispatchSyntheticBatch` de novo, mesmo depois de
/// o processo reiniciar. Não tem nenhuma relação com `SyntheticRun`/
/// `SyntheticRunClaim` (aquilo é idempotência de ETAPA/LOTE; isto é
/// idempotência de PEDIDO) nem com a Fase 9.
///
/// NUNCA guarda sessão viva, `sessionHandle`, executor, store, logger,
/// `AbortSignal`, credencial, CPF, senha, cookie, token, stack trace, erro
/// bruto, objeto de run completo, evidência/evento completos ou URL externa
/// — só o resultado administrativo SEGURO e fechado
/// (`ManualSyntheticDispatchResult`), revalidado na leitura
/// (`validateManualSyntheticDispatchResult`).
model ManualDispatchRequest {
  id String @id @default(uuid())

  /// Identificador de domínio do pedido — único: é ele que arbitra a
  /// idempotência administrativa no banco, não só na aplicação.
  requestId String @unique @map("request_id")
  batchId   String @map("batch_id")

  /// Hash SHA-256 estável do payload que define a identidade lógica do
  /// pedido (ver `computeManualDispatchRequestFingerprint`) — mesmo
  /// `requestId` com fingerprint diferente é conflito, nunca replay.
  fingerprint String @map("fingerprint")

  status ManualDispatchRequestDbStatus @default(PENDING) @map("status")

  /// Já REDIGIDO antes de chegar aqui (`redactLabText`) — nunca identidade
  /// real em claro.
  requestedBy String @map("requested_by")
  /// Sempre `SYNTHETIC_LAB` neste PR — coluna, não enum, para não acoplar o
  /// schema a uma lista que pertence ao domínio (`ManualDispatchEnvironment`).
  environment String @map("environment")
  /// Já redigido (`redactLabText`).
  reason      String @map("reason")

  requestedAt DateTime  @map("requested_at")
  completedAt DateTime? @map("completed_at")

  /// `ManualSyntheticDispatchResult` completo e seguro — `null` enquanto
  /// `status === PENDING`. Revalidado com
  /// `validateManualSyntheticDispatchResult` em toda leitura.
  result Json? @map("result")

  /// Versão da FORMA de `result` — ver `MANUAL_DISPATCH_RESULT_FORMAT_VERSION`.
  formatVersion String @map("format_version")

  /// Lease administrativa: protege a janela `reservar → dispatcher →
  /// salvar`. `null` quando não há reserva ativa (pedido já concluído e
  /// liberado). NUNCA identidade sensível — `claimedBy` é um rótulo
  /// fictício/opaco (ex.: `manual-${requestId}`), não um usuário real.
  executionToken String?   @map("execution_token")
  claimedBy      String?   @map("claimed_by")
  claimedAt      DateTime? @map("claimed_at")
  leaseExpiresAt DateTime? @map("lease_expires_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Cobre `status` sozinho (contagem/filtragem geral) e, junto com
  /// `leaseExpiresAt`, a varredura de `listRecoverable` (`PENDING` + lease
  /// vencida) e de reserva ainda válida (`PENDING` + lease no futuro).
  @@index([status])
  @@index([status, leaseExpiresAt])
  @@index([createdAt])
  @@map("manual_dispatch_requests")
}
